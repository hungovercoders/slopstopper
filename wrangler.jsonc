{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slopstopper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  },
  // Workers Logs stay off: the Worker only redirects and serves files, and
  // off means Cloudflare keeps no per-request records (IP included) that
  // we can read. app/privacy.html and every footer say so; turning this on
  // is a change to both.
  "observability": {
    "enabled": false
  }
}
